# Base Dockerfile for Bayora Core Services
FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/home/bayora/.local/bin:$PATH"

# Create unprivileged runtime user and group with fixed UID/GID 10001
RUN groupadd -g 10001 bayora && \
    useradd -u 10001 -g bayora -m -s /bin/false bayora && \
    mkdir -p /app /tmp/bayora /run/secrets && \
    chown -R bayora:bayora /app /tmp/bayora /run/secrets && \
    chmod 700 /tmp/bayora /run/secrets

WORKDIR /app

# Install dependencies as root, then hand off
COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy application source
COPY backend/bayora /app/bayora

RUN chown -R bayora:bayora /app

USER 10001:10001

EXPOSE 8000
CMD ["uvicorn", "bayora.main:app", "--host", "0.0.0.0", "--port", "8000"]
